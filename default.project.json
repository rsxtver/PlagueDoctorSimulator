{
  "name": "PlagueDoctorSimulator",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Remotes": {
        "$className": "Folder",
        "Notify": { "$className": "RemoteEvent" },
        "BuyUpgrade": { "$className": "RemoteFunction" },
        "Rebirth": { "$className": "RemoteFunction" },
        "PetRequest": { "$className": "RemoteFunction" },
        "EggHatched": { "$className": "RemoteEvent" },
        "AuraRequest": { "$className": "RemoteFunction" }
      },
      "Shared": { "$path": "src/ReplicatedStorage/Shared" },
      "Models": { "$path": "assets/Models.rbxm" }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "MainServer": { "$path": "src/ServerScriptService/MainServer.server.luau" },
      "Services": { "$path": "src/ServerScriptService/Services" }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "HUD": { "$path": "src/StarterPlayer/StarterPlayerScripts/HUD.client.luau" },
        "Shop": { "$path": "src/StarterPlayer/StarterPlayerScripts/Shop.client.luau" },
        "Rebirth": { "$path": "src/StarterPlayer/StarterPlayerScripts/Rebirth.client.luau" },
        "Pets": { "$path": "src/StarterPlayer/StarterPlayerScripts/Pets.client.luau" },
        "PetsUI": { "$path": "src/StarterPlayer/StarterPlayerScripts/PetsUI.client.luau" },
        "Auras": { "$path": "src/StarterPlayer/StarterPlayerScripts/Auras.client.luau" }
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "NPCTemplates": { "$className": "Folder" }
    },

    "Workspace": {
      "$className": "Workspace",
      "Zones": {
        "$className": "Folder",
        "Village": {
          "$className": "Folder",
          "Infected": { "$className": "Folder" },
          "Pharmacy": {
            "$className": "Folder",
            "SellPart": {
              "$className": "Part",
              "$properties": {
                "Anchored": true,
                "CanCollide": false,
                "Transparency": 0.5,
                "Size": [12, 1, 12],
                "Position": [0, 0.5, 30],
                "Color": [0.25, 0.85, 0.35],
                "Material": "Neon"
              }
            }
          }
        }
      }
    }
  }
}
